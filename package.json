{
  "name": "dsh-collab-board",
  "version": "0.11.13",
  "description": "协作看板：多台 DSH 之间的任务、对话、产出，右侧边栏一屏看得见。",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/host/index.mjs",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  }
}
